@startuml 02-network-setup-and-dns
' References: Kurose & Ross Ch. 2 / Ch. 6; RFC 2131, 2132, 1034, 1035.
' https://gaia.cs.umass.edu/kurose_ross/videos/2/
' https://www.rfc-editor.org/rfc/rfc2131
' https://www.rfc-editor.org/rfc/rfc1034
hide footbox
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam maxMessageSize 360
skinparam shadowing false
skinparam roundcorner 8
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #475569
  ParticipantFontColor #0F172A
  GroupBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
